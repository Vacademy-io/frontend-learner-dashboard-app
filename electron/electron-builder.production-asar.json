

{
  "electronVersion": "26.6.2",
  "appId": "com.shikshanation.learner",
  "productName": "Shiksha Nation",
  "directories": {
    "buildResources": "resources",
    "output": "dist"
  },
  "files": [
    "!**/*.map",
    "!**/*.ts",
    "!**/*.md",
    "!**/test/**",

    "assets/**/*",
    "build/**/*",
    "app/**/*",
    "capacitor.config.*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "app-update.yml",
      "to": "app-update.yml"
    }
  ],
  "asar": true,
  "asarUnpack": ["**/*.node"],
  "compression": "maximum",
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "npmRebuild": true,

  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "runAfterFinish": true,
    "installerHeaderIcon": "assets/shikshanation.ico"
  },

  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      },
      {
        "target": "portable",
        "arch": ["x64", "ia32"]
      }
    ],
    "icon": "assets/shikshanation.ico"
  }
}


